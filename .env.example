# Environment Variables

# OpenAI API Key (required for LLM chat functionality)
OPENAI_API_KEY=your-openai-api-key-here

# Supabase Real-Time Persistence (Required for Live Network, Shares, and Memory)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DEMO_STORE_ID=00000000-0000-0000-0000-000000000000

# Debugging / Auditing
VITE_EVIDENCE_ENABLED=true
VITE_ENABLE_TTS=true
VITE_ENABLE_UI_SFX=true
VITE_ENABLE_TAVILY_DEBUG=false
VITE_ENABLE_TAVILY_RAW_DUMP=false
ENABLE_TAVILY_DEBUG=false
ENABLE_TAVILY_RAW_DUMP=false
